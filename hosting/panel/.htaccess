Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule (^|/)(data|tools|tests)(/|$) - [F,L,NC]
 RewriteRule (^|/)(config\.php|config\.example\.php|schema\.sql|composer\.(json|lock)|\.env.*)$ - [F,L,NC]
 RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
</IfModule>
<FilesMatch "^(?:config\.php|config\.example\.php|schema\.sql|\.env.*)$">
 Require all denied
</FilesMatch>
